              "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', take(format('{0}stor', variables('prefix')), 24)), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-web-id', variables('prefix'))), variables('blobDataContributorRoleId'))]",
