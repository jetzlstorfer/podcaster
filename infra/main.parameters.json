{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=swedencentral}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP=rg-podcaster}"
    },
    "foundryProjectEndpoint": {
      "value": "${FOUNDRY_PROJECT_ENDPOINT}"
    },
    "researcherAgentName": {
      "value": "${RESEARCHER_AGENT_NAME=}"
    },
    "scriptwriterAgentName": {
      "value": "${SCRIPTWRITER_AGENT_NAME=}"
    },
    "narratorAgentName": {
      "value": "${NARRATOR_AGENT_NAME=}"
    },
    "foundryModel": {
      "value": "${FOUNDRY_MODEL=gpt-5-mini}"
    },
    "foundryImageModel": {
      "value": "${FOUNDRY_IMAGE_MODEL=MAI-Image-2.5-Flash}"
    },
    "authClientId": {
      "value": "${AUTH_CLIENT_ID=}"
    },
    "authClientSecret": {
      "value": "${AUTH_CLIENT_SECRET=}"
    }
  }
}
