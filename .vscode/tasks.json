{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate prerequisites",
      "type": "aitk",
      "command": "debug-check-prerequisites",
      "args": {
        "portOccupancy": [5679, 8088]
      }
    },
    {
      "label": "Run Podcaster HTTP Server",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m debugpy --listen 127.0.0.1:5679 -m agentdev run main.py --verbose --port 8088 -- --server",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": ["Validate prerequisites"],
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete|[Rr]unning on|Started server process|Starting Podcaster"
        }
      }
    },
    {
      "label": "Open Agent Inspector",
      "type": "shell",
      "command": "echo '${input:openAgentInspector}'",
      "presentation": {
        "reveal": "never"
      },
      "dependsOn": ["Run Podcaster HTTP Server"]
    },
    {
      "label": "Run Podcaster CLI",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m debugpy --listen 127.0.0.1:5679 main.py --cli --question \"${input:researchQuestion}\"",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "\\[Podcaster\\]|Script:"
        }
      }
    },
    {
      "label": "Terminate All Tasks",
      "command": "echo ${input:terminate}",
      "type": "shell",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openAgentInspector",
      "type": "command",
      "command": "ai-mlstudio.openTestTool",
      "args": { "triggeredFrom": "tasks", "port": 8088 }
    },
    {
      "id": "researchQuestion",
      "type": "promptString",
      "description": "Research question for the podcast pipeline",
      "default": "What are the latest breakthroughs in quantum computing?"
    },
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}
