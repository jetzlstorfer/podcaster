# Local-run config for the researcher hosted agent (`azd ai agent run`).
# Copy to `.env` and fill in. FOUNDRY_PROJECT_ENDPOINT + the model deployment
# are also injected by the hosting platform in the cloud.
FOUNDRY_PROJECT_ENDPOINT=https://podcaster-resource.services.ai.azure.com/api/projects/podcaster
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini
LOG_LEVEL=INFO
