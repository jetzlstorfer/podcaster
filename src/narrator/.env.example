# Local-run config for the narrator hosted agent (`azd ai agent run`).
# The narrator uses no model. It needs Speech + Blob storage. Point
# AZURE_STORAGE_ACCOUNT_URL at a real account (or Azurite) to exercise upload.
AZURE_SPEECH_ENDPOINT=https://swedencentral.tts.speech.microsoft.com
AZURE_SPEECH_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/rg-podcaster/providers/Microsoft.CognitiveServices/accounts/<speech-account>
USE_SPEECH_ENTRA_AUTH=true
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=audio
LOG_LEVEL=INFO
