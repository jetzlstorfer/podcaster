# ── Foundry / Model ──────────────────────────────────────────────────────────
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://podcaster-resource.services.ai.azure.com/api/projects/podcaster
FOUNDRY_MODEL=gpt-5-mini

# Optional failover deployment used after repeated 429 rate-limit errors on the
# primary. Only adds capacity if it has INDEPENDENT quota — put it in a different
# region (set both vars) or a separate resource. Leave blank to disable failover.
FOUNDRY_MODEL_FALLBACK=
FOUNDRY_PROJECT_ENDPOINT_FALLBACK=

# ── MAI image model (episode cover art) ───────────────────────────────────────
# Deployment name of a MAI-family image model in the SAME Foundry project (reuses
# FOUNDRY_PROJECT_ENDPOINT). Leave blank to disable image generation — the
# pipeline still completes and the image step emits a skip message.
FOUNDRY_IMAGE_MODEL=MAI-Image-2.5-Flash
# Output dimensions for the MAI images API (each side >= 768, width*height <=
# 1,048,576). Output is always PNG.
IMAGE_SIZE=1024x1024

# ── Azure Speech (MAI-Voice-2) ────────────────────────────────────────────────
# Format: https://<region>.tts.speech.microsoft.com/
AZURE_SPEECH_ENDPOINT=
# Leave AZURE_SPEECH_KEY blank to use Entra ID auth (required for Foundry resources
# with local/key auth disabled).
AZURE_SPEECH_KEY=
USE_SPEECH_ENTRA_AUTH=true
# Account-level ARM resource ID (no /projects/... suffix). Required for Entra ID:
# the TTS REST API expects the token wrapped as aad#<resourceId>#<token>.
# Example: /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>
AZURE_SPEECH_RESOURCE_ID=

# ── Podcast voices ────────────────────────────────────────────────────────────
PODCAST_VOICE_MALE=en-US-Ethan:MAI-Voice-2
PODCAST_VOICE_FEMALE=en-US-Harper:MAI-Voice-2
HOST_MALE=Ethan
HOST_FEMALE=Harper

# ── Observability / logging ───────────────────────────────────────────────────
# Console log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Enable Microsoft Agent Framework OpenTelemetry (traces + metrics + logs).
ENABLE_OTEL=false
# Print OTel spans/metrics to the console (local debugging without a collector).
ENABLE_CONSOLE_EXPORTERS=false
# Standard OTLP exporter endpoint (e.g. a local collector or Aspire dashboard).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Export to the AI Toolkit / Azure AI Foundry VS Code extension on this port.
# VS_CODE_EXTENSION_PORT=
# Optional Azure Monitor / Application Insights (needs azure-monitor-opentelemetry).
# APPLICATIONINSIGHTS_CONNECTION_STRING=

